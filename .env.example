# Copy to .env and fill in. Never commit .env.
PORT=3000

# Any PostgreSQL 14+ works. `npm run db:local` starts one on port 5433 with these defaults.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/fleettrack

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

JWT_EXPIRES_IN=24h
LOCATION_MAX_AGE_MINUTES=15
AUTO_ASSIGN_RADIUS_KM=25
