{
  "name": "fleettrack-node",
  "version": "1.0.0",
  "description": "FleetTrack fleet management API: Node.js, Express and PostgreSQL with raw SQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "db:local": "node scripts/local-db.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js",
    "globalTeardown": "./tests/globalTeardown.js",
    "testTimeout": 30000
  }
}
